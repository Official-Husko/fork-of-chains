:: QuestSetup_kidnap_a_hedge_mage_s_apprentice [nobr quest]


<<run new setup.UnitGroup(
"kidnap_a_hedge_mage_s_apprentice0",
"Vale Apprentice",
'subrace_humanvale', /* pools */
0, /* reuse chance */
[ /* unit post process */
  setup.qc.BgTraitReset('unit', setup.trait.bg_apprentice),
  setup.qc.Trait('unit', setup.trait.magic_water),
],
)>>




<<set _criteriadistraction = new setup.UnitCriteria(
null, /* key */
'Fast Talking Mage', /* name */
[
  setup.trait.per_sly,
  setup.trait.per_gregarious,
  setup.trait.per_playful,
  setup.trait.per_lunatic,
  setup.trait.per_evil,
  setup.trait.skill_hypnotic,
  setup.trait.magic_fire,
  setup.trait.magic_fire_master,
  setup.trait.magic_water,
  setup.trait.magic_water_master,
  setup.trait.magic_wind,
  setup.trait.magic_wind_master,
  setup.trait.magic_earth,
  setup.trait.magic_earth_master,
  setup.trait.magic_light,
  setup.trait.magic_light_master,
  setup.trait.magic_dark,
  setup.trait.magic_dark_master,
],
[
  setup.trait.bg_thug,
  setup.trait.per_direct,
  setup.trait.per_loner,
  setup.trait.per_serious,
  setup.trait.per_honorable,
],
[
  setup.qres.Job(setup.job.slaver),
],
{
  social: 1.5,
  arcane: 1.5,
}
)>>
<<run new setup.QuestTemplate(
'kidnap_a_hedge_mage_s_apprentice', /* key */
"Kidnap a Hedge Mage\'s Apprentice", /* Title */
{ /* Author */
  name: "Litigation Jackson",
  url: "",
},
[ /* tags */
  'vale',
  'unit',
  'ire',
],
1, /* weeks */
setup.QUEST_DEFAULT_EXPIRATION, /* expiration weeks */
{ /* roles */
  'kidnapper': [ setup.qu.kidnapper, 1],
  'kidnapper2': [ setup.qu.kidnapper, 1],
  'distraction': [ _criteriadistraction, 1],
},
{ /* actors */
  'apprentice': 'kidnap_a_hedge_mage_s_apprentice0',
},
[ /* costs */
],
'Quest_kidnap_a_hedge_mage_s_apprentice',
setup.qdiff.normal22, /* difficulty */
[ /* outcomes */
  [
    'Quest_kidnap_a_hedge_mage_s_apprenticeCrit',
    [
      setup.qc.Slave('apprentice', "a|was a hedge mage\'s apprentice in the Vale, before running into your company.", undefined),
      setup.qc.Trait('apprentice', setup.trait.per_lustful),
      setup.qc.MoneyNormal(),
      setup.qc.Favor('outlaws', 25),
      setup.qc.Ire('humanvale', 1),
    ],
  ],
  [
    'Quest_kidnap_a_hedge_mage_s_apprenticeCrit',
    [
      setup.qc.Slave('apprentice', "a|was a hedge mage\'s apprentice in the Vale, before running into your company.", undefined),
      setup.qc.MoneyNormal(),
      setup.qc.Favor('outlaws', 25),
      setup.qc.Ire('humanvale', 1),
    ],
  ],
  [
    'Quest_kidnap_a_hedge_mage_s_apprenticeFailure',
    [
    ],
  ],
  [
    'Quest_kidnap_a_hedge_mage_s_apprenticeDisaster',
    [
    ],
  ],
],
[ /* quest pool and rarity */
[setup.questpool.vale, setup.rarity.rare],
],
[ /* restrictions */
],
